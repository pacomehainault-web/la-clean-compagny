# Copiez ce fichier en .env.local et remplissez les valeurs (voir README.md, section "Envoi d'email").
# .env.local n'est jamais commité dans git.
#
# Règle à retenir :
# - PAS de préfixe NEXT_PUBLIC_ => variable UNIQUEMENT lisible côté serveur
#   (API routes, lib/mailer.js). Next.js ne l'inclut jamais dans le bundle
#   envoyé au navigateur. C'est ici que doivent vivre les vrais secrets.
# - Préfixe NEXT_PUBLIC_ => variable intentionnellement visible dans le
#   navigateur (elle finit dans le JS livré au client, donc visible de
#   n'importe qui via l'inspecteur). À réserver aux identifiants qui sont
#   déjà conçus pour être publics (voir notes ci-dessous).

# ---------------------------------------------------------------------------
# SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Compte Gmail utilisé par lib/mailer.js pour envoyer les emails de devis/contact
# (routes /api/contact et /api/devis, jamais appelé depuis le navigateur).
GMAIL_USER=lacleancompagny49@gmail.com

# Mot de passe d'application Gmail (16 caractères, généré sur myaccount.google.com/apppasswords)
# ⚠️ Ce n'est PAS le mot de passe du compte Gmail lui-même.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---------------------------------------------------------------------------
# PUBLIQUES PAR CONCEPTION — ce ne sont pas des secrets malgré le préfixe
# ---------------------------------------------------------------------------
# EmailJS : la "clé publique" est faite pour vivre côté client. La vraie
# protection se configure sur emailjs.com → Account → Security : restreindre
# les "Allowed origins" à vos domaines (lacleancompagny.fr, previews Vercel),
# et surveiller les quotas d'envoi.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_ugnog14
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_655hkaq
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=SebLXFPtUd5Uj5qLX

# Cloudinary : le "cloud name" et l'"upload preset" d'un preset UNSIGNED sont
# eux aussi faits pour être publics. La vraie protection se configure dans
# Cloudinary → Settings → Upload → (votre preset) : cocher "Unsigned", limiter
# les formats autorisés (jpg, jpeg, png, webp), fixer une taille max par
# fichier, et éventuellement un dossier de destination dédié.
# Ne JAMAIS mettre la "API Secret" de Cloudinary ici ni nulle part dans ce
# projet : elle ne doit exister que côté Cloudinary / un futur usage serveur.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=yn3d3ee9
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=La clean compagny

# ---------------------------------------------------------------------------
# AUTRES
# ---------------------------------------------------------------------------

# URL définitive du site (SEO, sitemap, métadonnées) — publique par nature.
# ⚠️ Le site est servi sur .com (pas .fr) : vérifier que cette variable est
# réglée sur https://www.lacleancompagny.com sur Vercel, dans TOUS les
# environnements (Production ET Preview), sans quoi canonical/sitemap/OG
# pointeront vers le mauvais domaine malgré le repli correct dans le code.
NEXT_PUBLIC_SITE_URL=https://www.lacleancompagny.com

# Optionnel : ID Google Analytics 4 — publique par nature (visible dans
# n'importe quelle page qui charge gtag.js).
NEXT_PUBLIC_GA_ID=
